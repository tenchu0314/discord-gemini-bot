[Unit]
Description=Discord Gemini Bot (discord-gemini-bot)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=your_username
Group=your_username
WorkingDirectory=/home/your_username/discord-gemini-bot

# 環境変数ファイルを指定
EnvironmentFile=/home/your_username/discord-gemini-bot/.env

# 仮想環境（venv）のPythonを使用してボットを起動
ExecStart=/home/your_username/discord-gemini-bot/venv/bin/python /home/your_username/discord-gemini-bot/bot.py

# プロセスが異常終了した場合は自動的に再起動する（トークン無効化ループ防止のためStartLimitと併用）
Restart=on-failure
# 再起動までの待機時間（秒）
RestartSec=10

# セキュリティ強化設定
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

# ログ出力時のバッファリングおよびバイトコード生成を無効化
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
